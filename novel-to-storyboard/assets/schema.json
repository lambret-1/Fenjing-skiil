{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "novel-storyboard/2.0",
  "title": "小说转分镜 章级机读数据",
  "description": "一章一份。章级锚点只定义一次，每条 Clip 通过 cast / assets / states 引用并在渲染时全量展开。由 render_sd2.py 渲染为 Seedance 2.0 提示词。",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "style",
    "characters",
    "scenes",
    "assets",
    "constraints",
    "clips"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "novel-storyboard/2.0"
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "chapter",
        "ratio"
      ],
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string",
          "description": "作品名"
        },
        "chapter": {
          "type": "string",
          "description": "章节标识，如 第1章 / 场3"
        },
        "ratio": {
          "$ref": "#/definitions/ratio"
        },
        "model": {
          "type": "string",
          "default": "Seedance 2.0"
        },
        "source_chars": {
          "type": "integer",
          "minimum": 0,
          "description": "清洗后正文字数"
        },
        "spoken_chars": {
          "type": "integer",
          "minimum": 0,
          "description": "可发声字数"
        },
        "speech_rate": {
          "type": "number",
          "minimum": 1,
          "description": "本章采用的语速，字/秒"
        },
        "est_duration_s": {
          "type": "number",
          "minimum": 0,
          "description": "全章预估时长（秒）"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "era",
        "look",
        "palette",
        "grain"
      ],
      "additionalProperties": false,
      "properties": {
        "era": {
          "type": "string",
          "description": "年代与地域质感，如 1930年代民国江南"
        },
        "look": {
          "type": "string",
          "description": "影像风格，如 民国写实 / 2D动画 / 3D渲染"
        },
        "palette": {
          "type": "string",
          "description": "色调，如 冷灰绿低饱和"
        },
        "grain": {
          "type": "string",
          "description": "质感，如 胶片颗粒 / 数字锐利"
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "附加风格词，如 浅景深"
        }
      }
    },
    "characters": {
      "type": "array",
      "description": "人物锚点。有图的填 asset（指向 assets.id），无图的 asset 留 null，靠文字锚点。",
      "items": {
        "$ref": "#/definitions/character"
      }
    },
    "scenes": {
      "type": "array",
      "description": "场景锚点。只锁空间、时间、光线、道具，不写人物站位。",
      "items": {
        "$ref": "#/definitions/scene"
      }
    },
    "assets": {
      "type": "array",
      "description": "章节素材库，只列不加编号；每条 Clip 用 assets 字段按上传顺序排列，渲染时自动编号 @图片1…N。",
      "items": {
        "$ref": "#/definitions/asset"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "description": "全局约束。渲染时自动编号并去重，缺无字幕/无 Logo/无水印/仅人声/防双胞胎会报硬伤。",
      "items": {
        "type": "string"
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "description": "15 秒一条。数组顺序即 Clip 序号。",
      "items": {
        "$ref": "#/definitions/clip"
      }
    }
  },
  "definitions": {
    "ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16",
        "4:3",
        "1:1",
        "3:4",
        "21:9"
      ]
    },
    "character": {
      "type": "object",
      "required": [
        "id",
        "name",
        "age",
        "features"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "全章唯一，只用于数据引用，不进提示词"
        },
        "name": {
          "type": "string",
          "description": "提示词里唯一使用的称呼，全章不得换名"
        },
        "age": {
          "type": "string",
          "description": "年龄感，如 二十出头 / 六十上下"
        },
        "features": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string"
          },
          "description": "静态体貌特征：发型、服装主色与轮廓、体型、配饰。不写情绪与手持物。"
        },
        "signature": {
          "type": "string",
          "description": "标志性特征：疤痕、痣、手绳、胎记。有图也必须单列，不能被图抹掉。"
        },
        "asset": {
          "type": [
            "string",
            "null"
          ],
          "description": "对应 assets.id；null 表示无参考图的纯文字人物"
        }
      },
      "description": "人物锚点。有图的填 asset（指向 assets.id），无图的 asset 留 null，靠文字锚点。音色不进锚点，语气写在每句台词上。"
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "name",
        "place",
        "time",
        "light"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "place": {
          "type": "string",
          "description": "地点类型与空间层次，如 江南渡口木栈桥，桥头连接泥岸，桥尾停乌篷船"
        },
        "time": {
          "type": "string",
          "description": "时间，如 清晨"
        },
        "light": {
          "type": "string",
          "description": "光线与主光源，如 浓雾，天光未亮，散射光为主光源"
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "场景固有道具，如 木桩、缆绳、船板"
        },
        "asset": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "role",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "character",
            "scene",
            "prop",
            "camera_ref",
            "audio_ref"
          ]
        },
        "name": {
          "type": "string",
          "description": "渲染为 @图片N = 名称"
        },
        "file": {
          "type": "string",
          "description": "素材文件名或路径，仅供管理，不进提示词"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "clip": {
      "type": "object",
      "required": [
        "no",
        "duration_s",
        "ratio",
        "scene",
        "cast",
        "assets",
        "shots"
      ],
      "additionalProperties": false,
      "properties": {
        "no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "duration_s": {
          "type": "number",
          "minimum": 5,
          "maximum": 15
        },
        "ratio": {
          "$ref": "#/definitions/ratio"
        },
        "scene": {
          "type": "string",
          "description": "scenes.id"
        },
        "cast": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "本条出场人物，characters.id 列表；未定义的名字会报硬伤"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "本条实际上传的素材，按上传顺序排列，决定 @图片1…N"
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "人物本条状态，键为 characters.id；渲染为 本条状态：…"
        },
        "ambience": {
          "type": "string",
          "description": "本条环境音，渲染为 <…>"
        },
        "music": {
          "type": "string",
          "description": "本条配乐，渲染为 （…）；全篇唯一允许使用全角括号的位置"
        },
        "note": {
          "type": "string",
          "description": "给人看的制作备注，不进提示词"
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/definitions/shot"
          }
        }
      }
    },
    "shot": {
      "type": "object",
      "required": [
        "no",
        "focal",
        "camera",
        "composition",
        "movement",
        "shot_size",
        "visual",
        "stability"
      ],
      "additionalProperties": false,
      "properties": {
        "no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "focal": {
          "type": "object",
          "required": [
            "mm",
            "type",
            "dof"
          ],
          "additionalProperties": false,
          "properties": {
            "mm": {
              "type": "integer",
              "enum": [
                14,
                18,
                21,
                24,
                28,
                35,
                50,
                85,
                100,
                135,
                200
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "超广角",
                "广角",
                "小广角",
                "标准",
                "中长焦",
                "长焦",
                "超长焦"
              ]
            },
            "dof": {
              "type": "string",
              "enum": [
                "深景深",
                "中景深",
                "浅景深"
              ]
            }
          }
        },
        "camera": {
          "type": "object",
          "required": [
            "height",
            "angle"
          ],
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string",
              "description": "机位对着谁：写人物名、群体或空间，如 沈知微 / 栈桥全貌"
            },
            "height": {
              "type": "string",
              "enum": [
                "贴地",
                "低机位仰拍",
                "平视",
                "略高俯拍",
                "高机位俯拍",
                "顶俯"
              ]
            },
            "angle": {
              "type": "string",
              "enum": [
                "正面",
                "正侧面",
                "背侧45°",
                "背后跟随",
                "过肩",
                "反打",
                "侧面跟随",
                "远眺"
              ]
            },
            "text": {
              "type": "string",
              "description": "机位整行原文，填写后优先输出"
            }
          }
        },
        "composition": {
          "type": "string",
          "enum": [
            "中心构图",
            "三分法",
            "对角线构图",
            "引导线构图",
            "框架构图",
            "对称构图",
            "大面积留白",
            "前景遮挡",
            "黄金分割",
            "重复韵律",
            "无明确构图"
          ],
          "description": "输出保留为导演字段；同时要求画面里写出实际位置，不能只写术语"
        },
        "movement": {
          "type": "string",
          "enum": [
            "固定镜头",
            "跟拍",
            "背跟",
            "侧跟",
            "手持跟随",
            "横摇",
            "上下摇",
            "横移",
            "纵深推进",
            "慢推",
            "急推",
            "慢拉",
            "急拉",
            "升",
            "降",
            "环绕",
            "变焦",
            "甩镜"
          ],
          "description": "一镜只允许 1 种运镜"
        },
        "shot_size": {
          "type": "string",
          "enum": [
            "大远景",
            "远景",
            "全景",
            "中景",
            "中近景",
            "近景",
            "特写",
            "大特写"
          ]
        },
        "visual": {
          "type": "object",
          "required": [
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "五要素主体：谁、在哪、朝哪、身体哪部分怎么动、幅度速度"
            },
            "environment": {
              "type": "string",
              "description": "环境层次：前景/中景/背景各是什么，雾雨尘人群"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "关键道具及其与身体的接触关系"
            },
            "light": {
              "type": "string",
              "description": "光从哪来、明暗关系、有无投影"
            }
          },
          "description": "四项合起来构成完整画面；画面必须自足，不得依赖其他镜头或其他块"
        },
        "dialogue": {
          "type": "array",
          "description": "台词。每句必须带 tone，渲染为 『说话人+语气+说{台词}』；无台词留空数组，渲染为 台词：{}",
          "items": {
            "type": "object",
            "required": [
              "speaker",
              "text",
              "tone"
            ],
            "additionalProperties": false,
            "properties": {
              "speaker": {
                "type": "string",
                "description": "必须是 characters 里定义过的 name"
              },
              "text": {
                "type": "string"
              },
              "lang": {
                "type": "string",
                "description": "非中文语种标注，如 ja"
              },
              "tone": {
                "type": "string",
                "minLength": 1,
                "description": "语气状语，能直接接在「说」前，如 压低嗓子 / 冷冷地 / 试探着 / 一字一顿；不写动作"
              },
              "voiceover": {
                "type": "boolean",
                "default": false,
                "description": "画外心声/旁白。true 时渲染为『说话人画外+语气+说{…}』，不做口型"
              }
            }
          }
        },
        "eyeline": {
          "type": "string",
          "description": "视线落点"
        },
        "focus": {
          "type": "string",
          "description": "焦点锁定对象"
        },
        "stability": {
          "type": "string",
          "enum": [
            "稳定",
            "三脚架稳定",
            "云台稳定",
            "呼吸感微动",
            "步伐微晃",
            "微晃",
            "手持晃动",
            "剧烈晃动"
          ],
          "description": "JSON 保留；渲染时并入运镜行，稳定值不单独出行"
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "单镜音效，渲染为 <…>"
        }
      }
    }
  }
}
